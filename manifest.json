{
  "manifest_version": 3,
  "name": "Ušati (Nelečeni Ears Edition)",
  "short_name": "Ušati",
  "version": "1.1.2",
  "description": "Prepoznaje Vučića u YouTube prenosima i na novinskim portalima i crta mu magareće, zečije ili ogarske uši. Sve radi lokalno.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Ušati - Podesi uši",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lib/face-api.js",
        "lib/vucic_ref.js",
        "lib/usati_core.js",
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.nova.rs/*",
        "https://*.n1info.rs/*",
        "https://*.n1info.ba/*",
        "https://*.blic.rs/*",
        "https://*.kurir.rs/*",
        "https://*.informer.rs/*",
        "https://*.danas.rs/*",
        "https://*.politika.rs/*",
        "https://*.telegraf.rs/*",
        "https://*.mondo.rs/*",
        "https://*.alo.rs/*",
        "https://*.b92.net/*",
        "https://*.rts.rs/*",
        "https://*.vreme.com/*",
        "https://*.nin.rs/*",
        "https://*.glasbanjaluke.net/*",
        "https://glasbanjaluke.net/*"
      ],
      "js": [
        "lib/face-api.js",
        "lib/vucic_ref.js",
        "lib/usati_core.js",
        "content/news.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.svg",
        "models/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.nova.rs/*",
        "https://*.n1info.rs/*",
        "https://*.n1info.ba/*",
        "https://*.blic.rs/*",
        "https://*.kurir.rs/*",
        "https://*.informer.rs/*",
        "https://*.danas.rs/*",
        "https://*.politika.rs/*",
        "https://*.telegraf.rs/*",
        "https://*.mondo.rs/*",
        "https://*.alo.rs/*",
        "https://*.b92.net/*",
        "https://*.rts.rs/*",
        "https://*.vreme.com/*",
        "https://*.nin.rs/*",
        "https://*.glasbanjaluke.net/*",
        "https://glasbanjaluke.net/*"
      ]
    }
  ],
  "author": "Petrić Tools",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.nova.rs/*",
    "https://*.n1info.rs/*",
    "https://*.n1info.ba/*",
    "https://*.blic.rs/*",
    "https://*.ocdn.eu/*",
    "https://*.kurir.rs/*",
    "https://*.midas-network.com/*",
    "https://*.adriamedia.tv/*",
    "https://*.informer.rs/*",
    "https://*.danas.rs/*",
    "https://*.politika.rs/*",
    "https://*.telegraf.rs/*",
    "https://*.tf.rs/*",
    "https://*.mondo.rs/*",
    "https://*.alo.rs/*",
    "https://*.b92.net/*",
    "https://*.b92s.net/*",
    "https://*.rts.rs/*",
    "https://*.vreme.com/*",
    "https://*.nin.rs/*",
    "https://*.glasbanjaluke.net/*",
    "https://glasbanjaluke.net/*"
  ]
}
